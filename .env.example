# ── NetraASSIST Environment Configuration ────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# ── App ──────────────────────────────────────────────────────────────
PORT=3002

# ── Azure OpenAI (Primary LLM) ──────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5.1-prod
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── Fallback LLM deployments (optional) ─────────────────────────────
AZURE_OPENAI_DEPLOYMENT_FALLBACK=gpt-5.1
AZURE_OPENAI_DEPLOYMENT_FALLBACK_2=gpt-5

# ── LLM Routing ─────────────────────────────────────────────────────
# Set true for LLM-based tree routing; false for faster heuristic TOC routing
PAGEINDEX_LLM_TREE_ROUTING=true

# ── SharePoint (for document sync) ──────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://netraassist:changeme@db:5432/netraassist

# ── JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=

# ── Super Admin ──────────────────────────────────────────────────────
PERMANENT_ADMIN_EMAIL=infosec@netradyne.com
ADMIN_DEFAULT_PASSWORD=

# ── Workers ──────────────────────────────────────────────────────────
DOC_PROCESS_MAX_WORKERS=4
GUNICORN_WORKERS=4
GUNICORN_THREADS=4

# ── Redis (Celery task queue) ────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
